From 3e00ba9e6575c0ac5655a20ed33d1b0183469ce2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 26 Nov 2026 08:24:22 +0000
Subject: [PATCH 2/2] Allow building the core without any built-in graphics
 backend

- default graphics API and GetGraphicsAPI() no longer assert when OpenGL,
  Vulkan and Metal are all disabled (the frontend supplies a renderer)
- LatteBufferData: use LatteConst shader stage indices instead of
  VulkanRendererConst (same values)
- LatteShader: include robin_hood.h directly
---
 src/Cafe/HW/Latte/Core/LatteBufferData.cpp | 6 +++---
 src/Cafe/HW/Latte/Core/LatteShader.cpp     | 1 +
 src/config/ActiveSettings.cpp              | 3 ++-
 src/config/CemuConfig.h                    | 2 ++
 4 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/src/Cafe/HW/Latte/Core/LatteBufferData.cpp b/src/Cafe/HW/Latte/Core/LatteBufferData.cpp
index c08c98b6..cfd875d6 100644
--- a/src/Cafe/HW/Latte/Core/LatteBufferData.cpp
+++ b/src/Cafe/HW/Latte/Core/LatteBufferData.cpp
@@ -332,16 +332,16 @@ void LatteBufferCache_Sync(uint32 maxVtxIndex, uint32 baseInstance, uint32 insta
 	if (vertexShader && vertexShader->uniformMode == LATTE_DECOMPILER_UNIFORM_MODE_FULL_CBANK)
 	{
 		if (LatteBufferCache_syncGPUUniformBuffers(vertexShader, mmSQ_VTX_UNIFORM_BLOCK_START, LatteConst::ShaderType::Vertex, vsUniformBufferDirtyMask))
-			stageUniformModifiedMask |= (1<<VulkanRendererConst::SHADER_STAGE_INDEX_VERTEX);
+			stageUniformModifiedMask |= (1<<static_cast<int>(LatteConst::ShaderType::Vertex));
 	}
 	if (pixelShader && pixelShader->uniformMode == LATTE_DECOMPILER_UNIFORM_MODE_FULL_CBANK)
 	{
 		if (LatteBufferCache_syncGPUUniformBuffers(pixelShader, mmSQ_PS_UNIFORM_BLOCK_START, LatteConst::ShaderType::Pixel, psUniformBufferDirtyMask))
-			stageUniformModifiedMask |= (1<<VulkanRendererConst::SHADER_STAGE_INDEX_FRAGMENT); // todo - move this enum to Latte?
+			stageUniformModifiedMask |= (1<<static_cast<int>(LatteConst::ShaderType::Pixel)); // todo - move this enum to Latte?
 	}
 	if (geometryShader && geometryShader->uniformMode == LATTE_DECOMPILER_UNIFORM_MODE_FULL_CBANK)
 	{
 		if ( LatteBufferCache_syncGPUUniformBuffers(geometryShader, mmSQ_GS_UNIFORM_BLOCK_START, LatteConst::ShaderType::Geometry, gsUniformBufferDirtyMask) )
-			stageUniformModifiedMask |= (1<<VulkanRendererConst::SHADER_STAGE_INDEX_GEOMETRY);
+			stageUniformModifiedMask |= (1<<static_cast<int>(LatteConst::ShaderType::Geometry));
 	}
 }
diff --git a/src/Cafe/HW/Latte/Core/LatteShader.cpp b/src/Cafe/HW/Latte/Core/LatteShader.cpp
index a25e7711..b0c08a39 100644
--- a/src/Cafe/HW/Latte/Core/LatteShader.cpp
+++ b/src/Cafe/HW/Latte/Core/LatteShader.cpp
@@ -15,6 +15,7 @@
 #include "config/ActiveSettings.h"
 #include "Cafe/GameProfile/GameProfile.h"
 #include "util/containers/flat_hash_map.hpp"
+#include "util/containers/robin_hood.h"
 #include "util/helpers/StateHasher.h"
 #ifdef ENABLE_METAL
 #include "Cafe/HW/Latte/Renderer/Metal/LatteToMtl.h"
diff --git a/src/config/ActiveSettings.cpp b/src/config/ActiveSettings.cpp
index 2e8e155b..e25d708d 100644
--- a/src/config/ActiveSettings.cpp
+++ b/src/config/ActiveSettings.cpp
@@ -128,7 +128,8 @@ GraphicAPI ActiveSettings::GetGraphicsAPI()
 		return api;
 	fallbackAPI = fallbackAPI.value_or(kOpenGL);
 #endif
-	cemu_assert(fallbackAPI.has_value());
+	if (!fallbackAPI.has_value())
+		return api; // no built-in backend: the frontend provides its own renderer
 	return *fallbackAPI;
 }
 
diff --git a/src/config/CemuConfig.h b/src/config/CemuConfig.h
index 48c396f2..470b4840 100644
--- a/src/config/CemuConfig.h
+++ b/src/config/CemuConfig.h
@@ -79,6 +79,8 @@ constexpr GraphicAPI kDefaultGraphicsAPI = kVulkan;
 constexpr GraphicAPI kDefaultGraphicsAPI = kMetal;
 #elif defined(ENABLE_OPENGL)
 constexpr GraphicAPI kDefaultGraphicsAPI = kOpenGL;
+#else
+constexpr GraphicAPI kDefaultGraphicsAPI = kVulkan; // no built-in backend: the frontend installs its own renderer
 #endif
 
 enum AudioChannels
-- 
