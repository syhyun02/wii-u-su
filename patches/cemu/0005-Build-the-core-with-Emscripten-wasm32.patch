@@ -373,6 +373,38 @@ inline unsigned char _addcarry_u64(unsigned char carry, unsigned long long a, un
 
 #endif
 
+// WebAssembly: portable versions of the x86 intrinsics used by Cemu
+#if defined(__EMSCRIPTEN__)
+#include <time.h>
+
+inline void _mm_pause()
+{
+}
+
+inline uint64 __rdtsc()
+{
+	// nanosecond counter; PPCTimer measures the frequency at startup
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64)ts.tv_sec * 1000000000ull + (uint64)ts.tv_nsec;
+}
+
+inline void _mm_mfence()
+{
+	std::atomic_thread_fence(std::memory_order_seq_cst);
+}
+
+inline unsigned char _addcarry_u64(unsigned char carry, unsigned long long a, unsigned long long b, unsigned long long *result)
+{
+	unsigned long long r = a + b;
+	unsigned char c = r < a;
+	r += carry;
+	c |= (r < (unsigned long long)carry);
+	*result = r;
+	return c;
+}
+#endif
+
 // asserts
 
 
