diff --git a/src/Common/GuestMemoryBase.h b/src/Common/GuestMemoryBase.h
new file mode 100644
index 00000000..585e8fa4
--- /dev/null
+++ b/src/Common/GuestMemoryBase.h
@@ -0,0 +1,33 @@
+#pragma once
+// Type of memory_base, the host address of PowerPC address 0.
+//
+// On Emscripten (wasm32) the guest address space is placed into the wasm linear memory with a rotated
+// mapping, host = (guest + base) mod 2^32, so "memory_base + guestAddress" must wrap around. In C++ a
+// pointer addition that overflows is undefined and LLVM really does optimise based on that (it broke
+// coreinit's foreground bucket init). GuestMemoryBase performs the addition on integers instead, so the
+// existing "memory_base + x" expressions keep working without undefined behaviour.
+#include <cstdint>
+#include <type_traits>
+
+#if defined(__EMSCRIPTEN__)
+class GuestMemoryBase
+{
+public:
+	GuestMemoryBase() = default;
+	GuestMemoryBase& operator=(uint8_t* p) { m_base = (uint32_t)(uintptr_t)p; return *this; }
+	operator uint8_t*() const { return (uint8_t*)(uintptr_t)m_base; }
+	explicit operator uintptr_t() const { return m_base; }
+	explicit operator bool() const { return m_base != 0; }
+	bool operator!() const { return m_base == 0; }
+
+	template<typename T, std::enable_if_t<std::is_integral_v<T>, int> = 0>
+	uint8_t* operator+(T offset) const { return (uint8_t*)(uintptr_t)(uint32_t)(m_base + (uint32_t)offset); }
+
+	friend ptrdiff_t operator-(const void* p, const GuestMemoryBase& b) { return (ptrdiff_t)(uint32_t)((uint32_t)(uintptr_t)p - b.m_base); }
+private:
+	uint32_t m_base = 0;
+};
+using GuestMemoryBasePtr = GuestMemoryBase;
+#else
+using GuestMemoryBasePtr = uint8_t*;
+#endif
diff --git a/src/Common/MemPtr.h b/src/Common/MemPtr.h
index ecd40203..1dd24ca6 100644
--- a/src/Common/MemPtr.h
+++ b/src/Common/MemPtr.h
@@ -1,4 +1,5 @@
 #pragma once
+#include "Common/GuestMemoryBase.h"
 #include <type_traits>
 #include "betype.h"
 
@@ -9,7 +10,7 @@ using MPTR = uint32; // generic address in PowerPC memory space
 using VAddr = uint32; // virtual address
 using PAddr = uint32; // physical address
 
-extern uint8* memory_base;
+extern GuestMemoryBasePtr memory_base;
 extern uint8* PPCInterpreterGetStackPointer();
 extern uint8* PPCInterpreter_PushAndReturnStackPointer(sint32 offset);
 extern void PPCInterpreterModifyStackPointer(sint32 offset);
