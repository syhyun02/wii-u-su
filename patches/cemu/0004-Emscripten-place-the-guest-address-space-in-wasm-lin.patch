From fbe33fd7bf058a275424491f7af7ced6a3ec2bcd Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 26 Nov 2026 08:56:40 +0000
Subject: [PATCH 4/6] Emscripten: place the guest address space in wasm linear
 memory

Rotated mapping host = (guest + 0x20010000) mod 2^32: the guest regions from
0xE0000000 land at host 0x00010000 and those from 0x00010000 at 0x20020000;
the frontend links Emscripten's data/heap above 0x70100000. MemMapper becomes
a no-op allocator, pointer range checks use MMU_IsInPPCMemorySpace.
---
 src/Cafe/HW/MMU/MMU.cpp                    |  5 ++
 src/Cafe/HW/MMU/MMU.h                      |  7 ++-
 src/Cafe/OS/RPL/rpl.cpp                    |  4 +-
 src/util/CMakeLists.txt                    |  4 ++
 src/util/MemMapper/MemMapper.h             |  6 +++
 src/util/MemMapper/MemMapperEmscripten.cpp | 55 ++++++++++++++++++++++
 6 files changed, 78 insertions(+), 3 deletions(-)
 create mode 100644 src/util/MemMapper/MemMapperEmscripten.cpp

diff --git a/src/Cafe/HW/MMU/MMU.cpp b/src/Cafe/HW/MMU/MMU.cpp
index b9baf178..a1db2fdd 100644
--- a/src/Cafe/HW/MMU/MMU.cpp
+++ b/src/Cafe/HW/MMU/MMU.cpp
@@ -129,8 +129,13 @@ MMURange mmuRange_HIGHMEM				{ 0xFFFFF000, 0x00001000, MMU_MEM_AREA_ID::CPU_PER_
 void memory_init()
 {
 	// reserve a continous range of 4GB
+#if defined(__EMSCRIPTEN__)
+	if(!memory_base)
+		memory_base = (uint8*)(uintptr_t)CEMU_WASM_GUEST_BASE; // fixed location inside the wasm linear memory
+#else
 	if(!memory_base)
 		memory_base = (uint8*)MemMapper::ReserveMemory(nullptr, (size_t)0x100000000, MemMapper::PAGE_PERMISSION::P_RW);
+#endif
 	if( !memory_base )
 	{
 		debug_printf("memory_init(): Unable to reserve 4GB of memory\n");
diff --git a/src/Cafe/HW/MMU/MMU.h b/src/Cafe/HW/MMU/MMU.h
index 56fc34e6..2ae7ccbc 100644
--- a/src/Cafe/HW/MMU/MMU.h
+++ b/src/Cafe/HW/MMU/MMU.h
@@ -178,7 +178,7 @@ bool memory_isAddressRangeAccessible(MPTR virtualAddress, uint32 size);
 #define CPU_swapEndianU64(_v) _byteswap_uint64((uint64)(_v))
 #define CPU_swapEndianU32(_v) _byteswap_ulong((uint32)(_v))
 #define CPU_swapEndianU16(_v) _byteswap_ushort((uint16)(_v))
-#elif BOOST_OS_LINUX
+#elif BOOST_OS_LINUX || defined(__EMSCRIPTEN__)
 #define CPU_swapEndianU64(_v) bswap_64((uint64)(_v))
 #define CPU_swapEndianU32(_v) bswap_32((uint32)(_v))
 #define CPU_swapEndianU16(_v) bswap_16((uint16)(_v))
@@ -278,4 +278,9 @@ namespace MMU
 
 }
 
+#if defined(__EMSCRIPTEN__)
+// rotated mapping: every host address below Emscripten's static data (GLOBAL_BASE) belongs to the guest address space
+#define MMU_IsInPPCMemorySpace(__ptr) ((uintptr_t)(const uint8*)(__ptr) < 0x70100000u)
+#else
 #define MMU_IsInPPCMemorySpace(__ptr) ((const uint8*)(__ptr) >= memory_base && (const uint8*)(__ptr) < (memory_base + 0x100000000))
+#endif
diff --git a/src/Cafe/OS/RPL/rpl.cpp b/src/Cafe/OS/RPL/rpl.cpp
index 19df0853..3e802be4 100644
--- a/src/Cafe/OS/RPL/rpl.cpp
+++ b/src/Cafe/OS/RPL/rpl.cpp
@@ -943,7 +943,7 @@ bool RPLLoader_FixImportSymbols(RPLModule* rplLoaderContext, sint32 symtabSectio
 			}
 			if (symbolOffset < 8)
 			{
-				cemu_assert(symbolSectionAddress >= memory_base && symbolSectionAddress <= (memory_base + 0x100000000ULL));
+				cemu_assert(MMU_IsInPPCMemorySpace(symbolSectionAddress));
 				uint32 symbolSectionMPTR = memory_getVirtualOffsetFromPointer(symbolSectionAddress);
 				uint32 symbolRelativeAddress = (uint32)sym->symbolAddress - (uint32)symbolSection.virtualAddress;
 
@@ -1050,7 +1050,7 @@ bool RPLLoader_FixImportSymbols(RPLModule* rplLoaderContext, sint32 symtabSectio
 				)
 			{
 				// update virtual address to match actual mapped address
-				cemu_assert(symbolSectionAddress >= memory_base && symbolSectionAddress <= (memory_base + 0x100000000ULL));
+				cemu_assert(MMU_IsInPPCMemorySpace(symbolSectionAddress));
 				uint32 symbolSectionMPTR = memory_getVirtualOffsetFromPointer(symbolSectionAddress);
 				uint32 symbolRelativeAddress = (uint32)sym->symbolAddress - (uint32)symbolSection.virtualAddress;
 				sym->symbolAddress = (symbolSectionMPTR + symbolRelativeAddress);
