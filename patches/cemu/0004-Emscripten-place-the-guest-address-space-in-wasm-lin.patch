diff --git a/src/util/MemMapper/MemMapper.h b/src/util/MemMapper/MemMapper.h
index be307384..3037686e 100644
--- a/src/util/MemMapper/MemMapper.h
+++ b/src/util/MemMapper/MemMapper.h
@@ -1,5 +1,11 @@
 #pragma once
 
+#if defined(__EMSCRIPTEN__)
+// host address of guest address 0 in the wasm linear memory. Guest addresses wrap around 2^32, so the guest
+// regions at 0xE0000000+ land at host 0x00010000+ and the regions from 0x00010000 to 0x50000000 at 0x20020000+.
+#define CEMU_WASM_GUEST_BASE 0x20010000u
+#endif
+
 namespace MemMapper
 {
 	enum class PAGE_PERMISSION : uint32
diff --git a/src/util/MemMapper/MemMapperEmscripten.cpp b/src/util/MemMapper/MemMapperEmscripten.cpp
new file mode 100644
index 00000000..ee70d724
--- /dev/null
+++ b/src/util/MemMapper/MemMapperEmscripten.cpp
@@ -0,0 +1,55 @@
+// MemMapper for WebAssembly (wasm32).
+// There is no virtual memory: the wasm linear memory is one contiguous, zero-initialised block.
+// The 4GB Wii U address space is placed into it with a rotated mapping, host = (guest + CEMU_WASM_GUEST_BASE) mod 2^32
+// (see NOTES.md, section 4.3). The linker puts Emscripten's own data, stack and heap above the guest regions
+// (-sGLOBAL_BASE), so "reserving" and "committing" guest memory needs no work.
+#include "util/MemMapper/MemMapper.h"
+#include <cstdlib>
+#include <cstring>
+
+extern "C" char __global_base; // provided by wasm-ld: start of Emscripten's static data
+
+namespace MemMapper
+{
+	size_t GetPageSize()
+	{
+		return 4096;
+	}
+
+	static bool IsGuestPointer(void* p)
+	{
+		// guest memory occupies host addresses below the start of Emscripten's static data
+		return (uintptr_t)p < (uintptr_t)&__global_base;
+	}
+
+	void* ReserveMemory(void* baseAddr, size_t size, PAGE_PERMISSION permissionFlags)
+	{
+		cemu_assert(baseAddr == nullptr);
+		void* p = aligned_alloc(4096, (size + 4095) & ~(size_t)4095);
+		if (p)
+			memset(p, 0, size);
+		return p;
+	}
+
+	void FreeReservation(void* baseAddr, size_t size)
+	{
+		if (!IsGuestPointer(baseAddr))
+			free(baseAddr);
+	}
+
+	void* AllocateMemory(void* baseAddr, size_t size, PAGE_PERMISSION permissionFlags, bool fromReservation)
+	{
+		if (fromReservation)
+			return baseAddr; // memory is always present and zeroed (FreeMemory clears it again)
+		cemu_assert(baseAddr == nullptr);
+		return ReserveMemory(nullptr, size, permissionFlags);
+	}
+
+	void FreeMemory(void* baseAddr, size_t size, bool fromReservation)
+	{
+		if (fromReservation)
+			memset(baseAddr, 0, size); // emulate returning the pages to the OS
+		else
+			free(baseAddr);
+	}
+};
