+// CEMU_FIBER_LOCAL(type, name): a thread_local that belongs to the emulated CPU core rather than to the host thread.
+// On most platforms all fibers of a core run on one host thread, so this is a plain thread_local.
+// On Emscripten each fiber is its own host thread (there is no ucontext); the values are handed over on every
+// Fiber::Switch so the code observes the same semantics.
+#if defined(__EMSCRIPTEN__)
+namespace FiberLocal
+{
+	constexpr size_t kBlockSize = 256;
+	struct Block { alignas(16) uint8 data[kBlockSize]; };
+	Block& CurrentBlock();
+	size_t Reserve(size_t size, size_t align);
+}
+
+template<typename T>
+class fiber_local
+{
+	static_assert(std::is_trivially_copyable_v<T>);
+public:
+	fiber_local() : m_offset(FiberLocal::Reserve(sizeof(T), alignof(T))) {}
+	fiber_local(const T& v) : fiber_local() {} // initial value must be zero; the storage starts zeroed
+	T& get() const { return *reinterpret_cast<T*>(FiberLocal::CurrentBlock().data + m_offset); }
+	operator T&() const { return get(); }
+	fiber_local& operator=(const T& v) { get() = v; return *this; }
+	T operator->() const { return get(); }
+	T& operator++() { return ++get(); }
+	T operator++(int) { return get()++; }
+	T& operator--() { return --get(); }
+	T operator--(int) { return get()--; }
+private:
+	size_t m_offset;
+};
+#define CEMU_FIBER_LOCAL(type, name) fiber_local<type> name
+#else
+#define CEMU_FIBER_LOCAL(type, name) thread_local type name
+#endif
+
