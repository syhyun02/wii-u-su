index 00000000..0b3c3c6f
--- /dev/null
+++ b/src/util/Fiber/FiberEmscripten.cpp
@@ -0,0 +1,146 @@
+// Fiber implementation for WebAssembly (Emscripten).
+// WebAssembly cannot switch stacks, so every fiber runs on its own pthread and control is handed over
+// like a baton: Switch() wakes the target thread and puts the current one to sleep. Only one thread
+// of a fiber chain runs at any time, so the observable behaviour matches the ucontext implementation.
+#include "Fiber.h"
+#include <pthread.h>
+#include <semaphore>
+#include <atomic>
+#include <memory>
+
+namespace
+{
+	struct FiberImpl
+	{
+		std::binary_semaphore wake{0};
+		void (*entry)(void*) = nullptr;
+		void* userParam = nullptr;
+		Fiber* fiber = nullptr;
+		bool started = false;
+		std::atomic_bool exitRequested{false};
+		FiberLocal::Block* incomingBlock = nullptr; // core-local storage handed over by the fiber that woke us
+	};
+
+	thread_local Fiber* sCurrentFiber{};
+	thread_local std::shared_ptr<FiberImpl>* sCurrentImpl{};
+	thread_local FiberLocal::Block t_ownBlock{};
+	thread_local FiberLocal::Block* t_block{};
+	std::atomic<size_t> s_reservedBytes{0};
+
+	constexpr size_t kFiberStackSize = 2 * 1024 * 1024;
+	const bool s_trace = getenv("CEMU_FIBER_TRACE") != nullptr;
+
+	void* FiberThreadMain(void* arg)
+	{
+		auto* implRef = static_cast<std::shared_ptr<FiberImpl>*>(arg);
+		FiberImpl& impl = **implRef;
+		sCurrentImpl = implRef;
+		sCurrentFiber = impl.fiber;
+		t_block = impl.incomingBlock;
+		impl.entry(impl.userParam);
+		// fiber entry points are not supposed to return
+		cemu_assert_debug(false);
+		return nullptr;
+	}
+}
+
+namespace FiberLocal
+{
+	Block& CurrentBlock()
+	{
+		return t_block ? *t_block : t_ownBlock;
+	}
+
+	size_t Reserve(size_t size, size_t align)
+	{
+		size_t offset = s_reservedBytes.load();
+		size_t aligned;
+		do
+		{
+			aligned = (offset + align - 1) & ~(align - 1);
+		} while (!s_reservedBytes.compare_exchange_weak(offset, aligned + size));
+		cemu_assert(aligned + size <= kBlockSize);
+		return aligned;
+	}
+}
+
+Fiber::Fiber(void(*FiberEntryPoint)(void* userParam), void* userParam, void* privateData) : m_privateData(privateData)
+{
+	auto impl = new std::shared_ptr<FiberImpl>(std::make_shared<FiberImpl>());
+	(*impl)->entry = FiberEntryPoint;
+	(*impl)->userParam = userParam;
+	(*impl)->fiber = this;
+	m_implData = impl;
+}
+
+Fiber::Fiber(void* privateData) : m_privateData(privateData)
+{
+	auto impl = new std::shared_ptr<FiberImpl>(std::make_shared<FiberImpl>());
+	(*impl)->fiber = this;
+	(*impl)->started = true; // represents an already running thread
+	m_implData = impl;
+}
+
+Fiber::~Fiber()
+{
+	auto* implRef = static_cast<std::shared_ptr<FiberImpl>*>(m_implData);
+	std::shared_ptr<FiberImpl> impl = *implRef;
+	impl->fiber = nullptr;
+	if (impl->entry && impl->started)
+	{
+		// the fiber's thread is parked inside Switch(): let it terminate. It keeps its own reference to impl
+		impl->exitRequested = true;
+		impl->wake.release();
+	}
+	else
+	{
+		delete implRef;
+	}
+}
+
+Fiber* Fiber::PrepareCurrentThread(void* privateData)
+{
+	cemu_assert_debug(sCurrentFiber == nullptr);
+	sCurrentFiber = new Fiber(privateData);
+	sCurrentImpl = static_cast<std::shared_ptr<FiberImpl>*>(sCurrentFiber->m_implData);
+	t_block = &t_ownBlock;
+	return sCurrentFiber;
+}
+
+void Fiber::Switch(Fiber& targetFiber)
+{
+	std::shared_ptr<FiberImpl> self = *sCurrentImpl; // keep alive even if our Fiber object is deleted meanwhile
+	FiberImpl& target = **static_cast<std::shared_ptr<FiberImpl>*>(targetFiber.m_implData);
+	target.incomingBlock = &FiberLocal::CurrentBlock();
+	if (s_trace)
+		fprintf(stderr, "[fiber] %p -> %p%s\n", (void*)sCurrentFiber, (void*)&targetFiber, target.started ? "" : " (start)");
+	if (!target.started)
+	{
+		target.started = true;
+		pthread_attr_t attr;
+		pthread_attr_init(&attr);
+		pthread_attr_setstacksize(&attr, kFiberStackSize);
+		pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+		pthread_t thread;
+		int r = pthread_create(&thread, &attr, FiberThreadMain, targetFiber.m_implData);
+		pthread_attr_destroy(&attr);
+		cemu_assert(r == 0);
+	}
+	else
+	{
+		target.wake.release();
+	}
+	self->wake.acquire();
+	if (self->exitRequested)
+	{
+		self.reset();
+		delete sCurrentImpl;
+		pthread_exit(nullptr);
+	}
+	t_block = self->incomingBlock;
+}
+
+void* Fiber::GetFiberPrivateData()
+{
+	return sCurrentFiber->m_privateData;
+}
